# Generated by swarm_ansible_deploy (tasks/drivers_container.yml) from our
# ros2_swarm/src/swarm_bringup/config/swarm_config.yaml, so the robot list lives in one place.
# Bind-mounted over the drivers image's config/swarm_config.yaml. Nodes come from SWARM_NODES (vars.yml).
default_nodes: [chassis, gnss, health]

robots:
{% for r in swarm_cfg.robots %}
  - name: {{ r.name }}
    beacon: {{ r.beacon }}
    serial: {{ r.serial }}
    init_orientation: {{ r.init_orientation }}
    conn_type: {{ conn_type }}
{% if r.ip is defined %}
    ip: {{ r.ip }}
{% endif %}
{% if r.marvelmind_port is defined %}
    marvelmind_port: {{ r.marvelmind_port }}
{% endif %}
{% endfor %}
