<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>virtual_target</name>
  <version>0.0.0</version>
  <description>Geometric perception simulator: publishes virtual landmarks/targets for centralized testing with no camera.</description>
  <maintainer email="elghali@todo.todo">elghali</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>swarm_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
