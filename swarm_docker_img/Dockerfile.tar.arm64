# syntax=docker/dockerfile:1.20

FROM elghaliasri/ros2-humble-swarm:robot-arm64-v8

SHELL ["/bin/bash", "-c"]

# ================================
# System Dependencies
# ================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    libopus-dev \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    ros-humble-xacro \
    ros-humble-launch-xml \
    ros-humble-cv-bridge \
    ros-humble-launch-testing-ament-cmake \
    ros-humble-ffmpeg-encoder-decoder \
    gpiod \
    && rm -rf /var/lib/apt/lists/*

# ================================
# Exact Python Environment
# ================================
RUN mkdir -p /root/.local/lib/python3.10
ADD swarm_docker_img/python_arm64_env.tar.gz /root/.local/lib/python3.10/

ENV PYTHONPATH=/root/.local/lib/python3.10/site-packages

RUN python3 -m pip install --no-cache-dir gpiod

# ================================
# Clean inherited v8 workspace
# ================================
WORKDIR /
RUN rm -rf /ros2_ws

# ================================
# ROS Dependencies
#
# Copy ONLY package.xml files first.
# Normal .py/.cpp/.yaml/launch changes will NOT invalidate rosdep.
# ================================
COPY --parents \
    ./ros2_marvelmind/src/**/package.xml \
    ./ros2_robomaster/src/**/package.xml \
    ./ros2_swarm/src/**/package.xml \
    /tmp/rosdep_src/

RUN rosdep init 2>/dev/null || true && \
    apt-get update && \
    rosdep update && \
    rosdep install --from-paths /tmp/rosdep_src --ignore-src -r -y && \
    rm -rf /tmp/rosdep_src /var/lib/apt/lists/*

RUN echo "=== BUILTIN INTERFACES CHECK ===" && \
    dpkg -l | grep -E 'ros-humble-(builtin-interfaces|rosidl-generator-c|std-msgs)' && \
    find /opt/ros/humble -name 'libbuiltin_interfaces__rosidl_generator_c.so*' -ls
# ================================
# Workspace
# ================================
WORKDIR /ros2_ws
RUN mkdir -p src

# Full source is copied AFTER rosdep
COPY ros2_marvelmind/src/ src/
COPY ros2_robomaster/src/ src/
COPY ros2_swarm/src/ src/

# ================================
# Build
# ================================
RUN source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install \
    --cmake-args -DCMAKE_CXX_FLAGS="-Wno-error=deprecated-declarations"

# ================================
# Runtime
# ================================
COPY swarm_docker_img/init.sh /init.sh
RUN chmod +x /init.sh

RUN usermod -aG dialout root

ENTRYPOINT ["/init.sh"]